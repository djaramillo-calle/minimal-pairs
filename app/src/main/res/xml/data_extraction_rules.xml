<?xml version="1.0" encoding="utf-8"?>
<!-- The learner's Azure key lives in the "minimal-pairs" preferences file:
     keep it out of cloud backup and device-to-device transfer (API 31+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="minimal-pairs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="minimal-pairs.xml" />
    </device-transfer>
</data-extraction-rules>
